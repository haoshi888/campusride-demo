{
  "name": "campusride",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "test:logic": "node scripts/test-logic.ts",
    "vercel-build": "prisma generate --schema prisma/schema.postgresql.prisma && prisma db push --schema prisma/schema.postgresql.prisma --skip-generate && tsx scripts/seed-if-empty.ts && next build",
    "db:seed:deploy": "prisma generate --schema prisma/schema.postgresql.prisma && tsx prisma/seed.ts",
    "db:validate:deploy": "prisma validate --schema prisma/schema.postgresql.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.542.0",
    "next": "15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.2",
    "postcss": "8.5.6",
    "prisma": "6.15.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
